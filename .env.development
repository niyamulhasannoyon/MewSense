NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

JWT_SECRET=development-mewsense-jwt-secret-key-32-chars-ok
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=development-mewsense-refresh-secret-key-32-ok
REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mewsense_dev?schema=public
REDIS_URL=redis://localhost:6379
ENABLE_IN_MEMORY_QUEUE_FALLBACK=true

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/uploads
STORAGE_MAX_FILE_SIZE_BYTES=15728640

ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_SECRET=mewsense-internal-ml-secret-key
ML_INFERENCE_TIMEOUT_MS=10000

RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=debug
