{
  "name": "mewsense-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production AI-Powered Cat Vocalization Analysis Application",
  "scripts": {
    "build": "pnpm --filter @mewsense/api db:generate && pnpm --filter \"./packages/*\" --filter \"./apps/*\" --filter \"./workers/*\" run build",
    "build:web": "pnpm --filter @mewsense/shared-types --filter @mewsense/validation build && pnpm --filter @mewsense/web build",
    "build:api": "pnpm --filter @mewsense/shared-types --filter @mewsense/validation build && pnpm --filter @mewsense/api db:generate && pnpm --filter @mewsense/api build",
    "dev": "pnpm --parallel run dev",
    "dev:api": "pnpm --filter @mewsense/api run dev",
    "dev:web": "pnpm --filter @mewsense/web run dev",
    "dev:worker": "pnpm --filter @mewsense/worker run dev",
    "dev:ml": "cd apps/ml-service && python3 -m uvicorn main:app --reload --port 8000",
    "test": "pnpm --recursive run test",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "db:generate": "pnpm --filter @mewsense/api run db:generate",
    "db:migrate": "pnpm --filter @mewsense/api run db:migrate",
    "db:seed": "pnpm --filter @mewsense/api run db:seed"
  },
  "keywords": [
    "cat-sound-analysis",
    "bioacoustics",
    "machine-learning",
    "nextjs",
    "fastapi",
    "prisma"
  ],
  "author": "MewSense Team",
  "license": "UNLICENSED"
}
