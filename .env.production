NODE_ENV=production
PORT=4000
API_URL=https://api.mewsense.app
WEB_URL=https://mewsense.app

# In production, inject secrets via Vault, AWS Secrets Manager, or Kubernetes Secrets
JWT_SECRET=change-this-production-jwt-secret-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-this-production-refresh-secret-min-32
REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ORIGIN=https://mewsense.app

DATABASE_URL=postgresql://mewsense_admin:CHANGE_ME@db.mewsense.internal:5432/mewsense_prod?sslmode=require
REDIS_URL=rediss://default:CHANGE_ME@redis.mewsense.internal:6379
ENABLE_IN_MEMORY_QUEUE_FALLBACK=false

STORAGE_PROVIDER=s3
STORAGE_MAX_FILE_SIZE_BYTES=15728640
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_S3_BUCKET=mewsense-audio-prod
AWS_S3_ENDPOINT=

ML_SERVICE_URL=http://ml-service.internal:8000
ML_SERVICE_SECRET=CHANGE_ME_PRODUCTION_ML_SECRET
ML_INFERENCE_TIMEOUT_MS=15000

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info
SENTRY_DSN=
