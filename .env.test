NODE_ENV=test
PORT=4001
API_URL=http://localhost:4001
WEB_URL=http://localhost:3000

JWT_SECRET=test-environment-mewsense-jwt-secret-key-32
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=test-environment-mewsense-refresh-secret-32
REFRESH_TOKEN_EXPIRES_IN=1d
CORS_ORIGIN=*

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mewsense_test?schema=public
REDIS_URL=redis://localhost:6379
ENABLE_IN_MEMORY_QUEUE_FALLBACK=true

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/test_uploads
STORAGE_MAX_FILE_SIZE_BYTES=15728640

ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_SECRET=mewsense-internal-ml-secret-key
ML_INFERENCE_TIMEOUT_MS=5000

RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=error
