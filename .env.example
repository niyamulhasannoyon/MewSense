# MewSense Environment Configuration
# Node Environment
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Security & Secrets
JWT_SECRET=super-secret-mewsense-jwt-key-minimum-32-chars-long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super-secret-mewsense-refresh-key-minimum-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mewsense_dev?schema=public

# Redis & Queue
REDIS_URL=redis://localhost:6379
ENABLE_IN_MEMORY_QUEUE_FALLBACK=true

# Storage Provider (options: 'local', 's3', 'r2')
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/uploads
STORAGE_MAX_FILE_SIZE_BYTES=15728640

# AWS S3 / Cloudflare R2 (Optional if STORAGE_PROVIDER=s3 or r2)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=mewsense-audio-recordings
AWS_S3_ENDPOINT=

# Machine Learning Service (Python FastAPI)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_SECRET=mewsense-internal-ml-secret-key
ML_INFERENCE_TIMEOUT_MS=10000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Telemetry & Monitoring
LOG_LEVEL=info
SENTRY_DSN=
